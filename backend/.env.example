# Copy this file to .env and fill in your key.
#
# Provider options: groq (default, free) | openai | gemini
# Groq free tier: https://console.groq.com  → API Keys → Create key
# No credit card required.

LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Override the model if you want (optional)
# LLM_MODEL=llama-3.3-70b-versatile

# Uncomment to use OpenAI instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Uncomment to use Gemini instead:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# LLM_MODEL=gemini-2.0-flash
